{
  "name": "@jummon/auth-react-native",
  "version": "0.1.0",
  "description": "React Native / Expo adapters for @jummon/auth's agnostic core: AsyncStorage+SecureStore storage, expo-crypto PKCE, Linking-based social-login navigation, and react-native-passkey WebAuthn. Headless-only (mode: \"headless\") — no hosted-redirect mode on RN.",
  "license": "MIT",
  "author": "Jummon",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "tsup",
    "prepack": "node scripts/verify-no-file-deps.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jummon/auth": "^0.4.0"
  },
  "peerDependencies": {
    "react-native": ">=0.70",
    "@react-native-async-storage/async-storage": ">=1.19",
    "expo-secure-store": ">=13",
    "expo-crypto": ">=13",
    "expo-linking": ">=6",
    "react-native-passkey": ">=3"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    },
    "react-native-passkey": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jummon-one/jummon-auth-sdk.git",
    "directory": "packages/react-native"
  },
  "keywords": [
    "jummon",
    "oidc",
    "authentication",
    "auth",
    "pkce",
    "react-native",
    "expo",
    "passkey"
  ]
}
